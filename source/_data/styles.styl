// 自定义样式文件

// 添加一些自定义Stylus样式
body
  // 确保canvas背景不会影响其他元素
  canvas
    display block

  // 为页面添加平滑过渡效果
  transition all 0.3s ease

// 鼠标悬停时的发光效果
//.post-body:hover,
//.sidebar:hover,
//.header:hover
//  box-shadow 0 0 20px rgba(52, 152, 219, 0.3)
//  transition box-shadow 0.3s ease

// 自定义滚动条样式
::-webkit-scrollbar
  width 8px

::-webkit-scrollbar-track
  background rgba(0, 0, 0, 0.1)

::-webkit-scrollbar-thumb
  background linear-gradient(45deg, #3498db, #9b59b6)
  border-radius 4px

::-webkit-scrollbar-thumb:hover
  background linear-gradient(45deg, #2980b9, #8e44ad)

// 中文段落首行缩进
.post-body p,
.post-detail p,
.post-content p
  text-indent 2em
  margin 0
  padding 0

// 段落间距调整 - 移除段落间的空行间隔
.post-body p + p,
.post-detail p + p,
.post-content p + p
  margin-top 0

// 针对列表、引用等特殊元素取消缩进
.post-body ul li,
.post-body ol li,
.post-body blockquote p,
.post-detail ul li,
.post-detail ol li,
.post-detail blockquote p
  text-indent 0

// 标题不缩进
.post-body h1, .post-body h2, .post-body h3, .post-body h4, .post-body h5, .post-body h6
  text-indent 0

// =============================================================================
// Stripe 打赏按钮样式 — Apple 流光边框效果
// =============================================================================

// 流光旋转动画
@keyframes stripe-glow-spin
  0%
    --stripe-glow-angle 0deg
  100%
    --stripe-glow-angle 360deg

// 容器：撑满文章宽度
.stripe-donate-container
  margin 2em 0 0
  text-align center
  width 100%

// 外框：用 padding + 伪元素实现流光边框
.stripe-donate-inner
  position relative
  display block
  padding 1.8em 2em
  border-radius 14px
  background var(--body-bg-color, #fff)
  overflow hidden
  z-index 0

  // 流光边框层（伪元素）
  &::before
    content ''
    position absolute
    top -2px
    left -2px
    right -2px
    bottom -2px
    z-index -2
    border-radius 16px
    background conic-gradient(
      from var(--stripe-glow-angle, 0deg),
      #635bff 0%,
      #a78bfa 15%,
      #f472b6 30%,
      #fb923c 45%,
      #facc15 55%,
      #34d399 70%,
      #38bdf8 85%,
      #635bff 100%
    )
    animation stripe-glow-spin 4s linear infinite
    // 注册自定义属性以支持 conic-gradient 动画
    // 若浏览器不支持 @property，则回退为静态渐变

  // 遮罩层：露出 2px 的流光边框
  &::after
    content ''
    position absolute
    top 2px
    left 2px
    right 2px
    bottom 2px
    z-index -1
    border-radius 12px
    background var(--body-bg-color, #fff)

  &:hover::before
    animation-duration 2s
    filter brightness(1.2) blur(1px)

.stripe-donate-text
  text-indent 0 !important
  margin-bottom 1em !important
  color var(--text-color, #555)
  font-size 0.95em

// Stripe Buy Button 容器居中
.stripe-donate-btn-wrap
  display flex
  justify-content center
  align-items center
  min-height 48px

// 暗色模式适配
.darkmode
  .stripe-donate-inner
    background var(--body-bg-color, #1a1a2e)

    &::after
      background var(--body-bg-color, #1a1a2e)

  .stripe-donate-text
    color #ccc

